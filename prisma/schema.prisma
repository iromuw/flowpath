generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SUBMITTED
  APPLICATION_VIEWED
  PRE_SCREENING
  FIRST_ROUND
  SECOND_ROUND
  FINAL_ROUND
  OFFER
  NO_REPLY
  WITHDRAWN
  UNSUCCESSFUL
  JOB_CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CASUAL
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String?
  created_at   DateTime      @default(now())

  applications  Application[]
  saved_jobs    SavedJob[]
  job_platforms JobPlatform[]

  @@map("users")
}

model JobPlatform {
  id         String   @id @default(cuid())
  name       String
  is_active  Boolean  @default(true)
  user_id    String
  created_at DateTime @default(now())

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  applications Application[]
  saved_jobs   SavedJob[]

  @@unique([user_id, name])
  @@map("job_platforms")
}

model Application {
  id             String            @id @default(uuid())
  user_id        String?
  job_title      String
  company        String
  location       String
  submitted_date DateTime
  current_status ApplicationStatus @default(SUBMITTED)
  platform_id    String?
  job_url        String?
  company_url    String?
  salary_range   String?
  job_type       JobType
  work_mode      WorkMode
  notes          String?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  user           User?             @relation(fields: [user_id], references: [id])
  platform       JobPlatform?      @relation(fields: [platform_id], references: [id])
  status_history StatusHistory[]

  @@map("applications")
}

model StatusHistory {
  id             String            @id @default(uuid())
  application_id String
  status         ApplicationStatus
  changed_at     DateTime          @default(now())
  scheduled_at   DateTime?
  note           String?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@map("status_history")
}

model SavedJob {
  id           String    @id @default(uuid())
  user_id      String?
  job_title    String
  company      String
  location     String?
  platform_id  String?
  job_url      String?
  company_url  String?
  salary_range String?
  job_type     JobType
  work_mode    WorkMode
  notes        String?
  deadline     DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user         User?        @relation(fields: [user_id], references: [id])
  platform     JobPlatform? @relation(fields: [platform_id], references: [id])

  @@map("saved_jobs")
}
